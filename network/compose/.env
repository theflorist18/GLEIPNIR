# GLEIPNIR pinned image tags + compose defaults (docs/CONTRACTS.md §8).
# Never use :latest — it resolves to Fabric 3.x (docs/research/fabric-2.5.md §1).
COMPOSE_PROJECT_NAME=gleipnir

FABRIC_TAG=2.5.15
CA_TAG=1.5.19
TOOLS_TAG=2.5.15

# Active variant (orchestration/up.sh sets this). One of:
# standard | anchoring | parallel | parallel-anchored
VARIANT=standard

# Non-production auth token shared by gateway + verification.
GLEIPNIR_TOKEN=dev-token

# Evidence library (M12–M16). Internal token: gateway <-> case-registry /
# evidence-store shared secret. Admin seed: first-boot admin credentials
# (users.json on the gateway-auth-data volume). All non-production defaults.
GLEIPNIR_INTERNAL_TOKEN=internal-dev-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-dev-password

# Anchoring batch size — ONE grid for Anchoring (N) and Parallel-Anchored (K),
# overridden per run by orchestration/experiment.py. BATCH_FLUSH_MS=0 means
# size-only batching (partial batch flushed at run end).
BATCH_SIZE=50
BATCH_FLUSH_MS=0

# ccaas package IDs — written by orchestration/up.sh after `peer lifecycle
# chaincode calculatepackageid`. `unset` keeps `docker compose config` valid
# before the first install.
CCAAS_ID_APP=evidence_1.0:cd81c3740bb6a7198eb9138605d51749b4953b1874d87948af355bbe8e21e6bf
CCAAS_ID_ANCHOR=unset
BATCH_EPOCH=e0-anchoring-batch50-ch1-cases10-r0-1790133543
BATCH_N=50
BATCH_K=50
