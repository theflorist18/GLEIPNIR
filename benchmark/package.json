{
  "name": "gleipnir-benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "GLEIPNIR Hyperledger Caliper 0.6.0 workspace (trace-replay workloads, network configs, REST connector, audit reconstruction)",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "bind": "caliper bind --caliper-bind-sut fabric:fabric-gateway",
    "gen:trace": "node trace/generate.js",
    "audit": "node audit/reconstruct.js",
    "test": "node --test test/*.test.js",
    "launch:smoke": "caliper launch manager --caliper-workspace . --caliper-benchconfig benchmarks/smoke-standard.yaml --caliper-networkconfig networks/coc-main.yaml"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.3",
    "@hyperledger/caliper-cli": "0.6.0",
    "@hyperledger/fabric-gateway": "^1.5.0"
  },
  "devDependencies": {
    "js-yaml": "^4.3.0"
  }
}
